{
  "name": "landing_pages",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f compose.dev.yml up -d",
    "db:migrate": "node --env-file-if-exists=.env.development.local scripts/migrate.mjs",
    "pdf:epub": "node scripts/pdf-to-epub.mjs",
    "i18n:scan": "node scripts/find-hardcoded-strings.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "next": "16.1.6",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-pdf": "^10.4.1",
    "resend": "^6.9.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
