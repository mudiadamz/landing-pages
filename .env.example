# ── Required ─────────────────────────────────────────────────────────────────

# Supabase. The service role key bypasses RLS and is used ONLY by API routes
# (Duitku callback, Resend webhook, hiring upload) — never in a client component.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# The ONE fixed origin. Since multi-domain, per-request URLs (canonical tags, OG,
# sitemap, Duitku returnUrl) follow the host the visitor is on — this stays the
# fallback and, deliberately, the Duitku server-to-server callbackUrl. Default
# when unset: https://admuiux.com
NEXT_PUBLIC_SITE_URL=

# Duitku (payments). DUITKU_SANDBOX="true" uses the sandbox gateway; any other
# value means production.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_SANDBOX=

# Resend (purchase confirmation + email verification). RESEND_WEBHOOK_SECRET is
# needed only for the inbound-email webhook that feeds /panel/inbox.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# Meta Conversions API (server-side purchase events, deduped against the browser
# pixel by eventId). META_CAPI_VERSION defaults to v21.0.
NEXT_PUBLIC_FB_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_VERSION=

# Optional. Google Tag Manager container id — fallback when not set in
# /panel/tracking. Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Optional. HMAC key for the signup form token (lib/signup-guard). Any long
# random string; falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
SIGNUP_FORM_SECRET=

# Optional. Cloudflare Turnstile — signup captcha. Both must be set for the
# check to run; with either missing the widget is not rendered and the guard
# skips it. NEXT_PUBLIC_* is inlined at build, so redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional — lets /panel/sites add a new domain to the Vercel project itself
# instead of telling you to do it in the dashboard. With VERCEL_API_TOKEN unset,
# the panel falls back to written instructions and nothing breaks.
#
# The token is account/team-scoped, NOT endpoint-scoped: Vercel has no
# "domains only" token, so this one can do anything the team can. Keep it
# server-only (never NEXT_PUBLIC_), scope it to the team, and give it an expiry.
# Create at: Vercel → Account Settings → Tokens.
VERCEL_API_TOKEN=
# From .vercel/project.json (projectId / orgId). The API takes an id or a name, so
# VERCEL_PROJECT_NAME (e.g. "landing_pages") works as a fallback if the id is unset.
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
VERCEL_TEAM_ID=
