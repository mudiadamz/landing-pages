# ── Required ─────────────────────────────────────────────────────────────────

# Postgres, spoken to directly (lib/backend), as the `app` role. Every query
# runs inside a transaction as anon / authenticated / service_role, so RLS still
# decides. In production docker-compose.yml sets this itself (container `db`);
# for dev it is compose.dev.yml: postgresql://app:app@127.0.0.1:54329/lp
DATABASE_URL=
# Migrations (pnpm db:migrate) run as the database OWNER, and give the `app`
# role APP_DB_PASSWORD. Production: POSTGRES_PASSWORD + APP_DB_PASSWORD, both
# hex (`openssl rand -hex 32`) — they end up inside connection URLs.
# MIGRATE_DATABASE_URL=
# APP_DB_PASSWORD=
# POSTGRES_PASSWORD=
# Optional: connections per process (default 10).
# DATABASE_POOL_MAX=

# The edge's IP, given to ROOT domains (/panel/domains) — a CNAME is illegal at
# a zone apex, so those get an A record instead. Also what every DNS check
# compares against, whatever record shape the customer used.
# Default: 18.143.52.190
# CUSTOM_DOMAIN_IP=

# Hostname a business is told to CNAME its own subdomain to (/panel/domains).
# Must resolve to the edge that terminates TLS for customer domains — see
# docs/runbooks/custom-domains.md. Default: edge.mbahgpt.com
# CUSTOM_DOMAIN_TARGET=

# Files live on disk (lib/backend/storage.ts), <STORAGE_ROOT>/<bucket>/<path>.
# The Docker image sets /srv/storage, a named volume. Default: ./.storage
# STORAGE_ROOT=
# Signs private download URLs (HMAC). At least 32 random characters; changing
# it invalidates every signed URL already handed out (they last ≤ 1 hour).
STORAGE_SIGNING_SECRET=

# "Masuk dengan Google" (lib/backend/google.ts). Both empty = the button answers
# "belum dikonfigurasi". The OAuth client's Authorized redirect URIs must list
# https://<canonical host>/auth/callback (every storefront returns through it)
# and http://localhost:3000/auth/callback for dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The ONE fixed origin. Since multi-domain, per-request URLs (canonical tags, OG,
# sitemap, Duitku returnUrl) follow the host the visitor is on — this stays the
# fallback and, deliberately, the Duitku server-to-server callbackUrl. Default
# when unset: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Duitku (payments). DUITKU_SANDBOX="true" uses the sandbox gateway; any other
# value means production.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_SANDBOX=

# Duitku Disbursement — money going OUT, to a business's bank account
# (docs/plans/multi-business-saas.md, Fase 3). SEPARATE credentials from the
# payment ones above: a different merchant id and a different secret.
#
# Leave any of the three empty and automatic payouts stay OFF: the Platform
# screen shows only "Catat manual", exactly as before this existed. That is the
# intended default — this is the one API in the codebase whose mistake sends real
# money to a real stranger.
#
# DUITKU_DISBURSE_SANDBOX defaults to the sandbox; set it to "false" (and only
# then) to transfer for real.
DUITKU_DISBURSE_USER_ID=
DUITKU_DISBURSE_EMAIL=
DUITKU_DISBURSE_SECRET=
DUITKU_DISBURSE_SANDBOX=

# Resend (purchase confirmation + email verification). RESEND_WEBHOOK_SECRET is
# needed only for the inbound-email webhook that feeds /panel/inbox.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# Meta Conversions API (server-side purchase events, deduped against the browser
# pixel by eventId). META_CAPI_VERSION defaults to v21.0.
NEXT_PUBLIC_FB_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_VERSION=

# Optional. Google Tag Manager container id — fallback when not set in
# /panel/tracking. Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Live chat Tawk.to — fallback kalau /panel/tracking belum diisi untuk sebuah
# domain. Keduanya harus terisi; salah satu kosong berarti chat mati. Ambil dari
# URL embed di snippet Tawk: https://embed.tawk.to/<property>/<widget>
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Optional. HMAC key for the signup form stamp and email-verify links
# (lib/secrets.ts). Unset = derived from STORAGE_SIGNING_SECRET per purpose.
SIGNUP_FORM_SECRET=

# Optional. Cloudflare Turnstile — signup captcha. Both must be set for the
# check to run; with either missing the widget is not rendered and the guard
# skips it. NEXT_PUBLIC_* is inlined at build, so redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email untuk Let's Encrypt (dipakai Caddy saat menerbitkan sertifikat). Hanya
# relevan saat deploy dengan docker compose; ke sinilah pemberitahuan sertifikat
# akan kedaluwarsa dikirim.
#
# Tidak ada lagi VERCEL_* di sini: domain tidak didaftarkan ke mana pun. Baris di
# lp_sites yang menentukan domain mana yang sah, dan Caddy menanyakannya lewat
# /api/tls-check sebelum menerbitkan sertifikat.
ACME_EMAIL=

# ── MbahGPT (template chat) ──────────────────────────────────────────────────
# Hanya dipakai kalau ada storefront dengan template `mbahgpt`. Tanpa
# OPENROUTER_API_KEY halaman chat tetap tampil tapi bilang "belum aktif" —
# tidak ada yang error, dan tidak ada request yang keluar.
#
# Kunci ini TIDAK BOLEH ber-prefix NEXT_PUBLIC_: browser bicara ke
# /api/mbahgpt/chat, dan hanya route itu yang bicara ke OpenRouter.
OPENROUTER_API_KEY=

# Model & sampling diatur di sini, bukan di UI — route mengabaikan nilai model
# atau temperature yang dikirim klien.
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_TEMPERATURE=0.7

# Model kecil non-thinking untuk merangkum hasil pencarian web.
OPENROUTER_SEARCH_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Semua di bawah ini opsional; nilai berikut adalah defaultnya.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_WEB_RESULTS=5          # hasil per pencarian (BUKAN pengendali biaya:
#                                   # OpenRouter menagih ~$0.007 flat per pencarian,
#                                   # berapa pun jumlah hasilnya)
# OPENROUTER_MAX_HISTORY=40         # pesan yang dikirim ulang tiap giliran
# OPENROUTER_MAX_UPLOAD=8388608     # total byte lampiran per pesan
# OPENROUTER_MAX_FILES=6            # jumlah berkas per pesan
# OPENROUTER_TIMEOUT=120            # detik menunggu OpenRouter
# OPENROUTER_RATE_LIMIT=30          # giliran chat per menit per user (0 = mati)
